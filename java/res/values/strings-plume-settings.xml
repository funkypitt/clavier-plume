    <string name="plume_setup_welcome_title">Clavier Plume</string>
    <string name="plume_setup_welcome_body">A French and English keyboard, built first for writing French well. One minute to set up.</string>
    <string name="plume_setup_welcome_differs_title">What sets it apart</string>
    <string name="plume_setup_welcome_differs">Commercial keyboards are designed for English, and most open-source keyboards reuse their engine as is. Plume knows French elision (l\', d\', qu\'), recovers accents, respects French typography, switches languages with one key, and only learns a word after seeing it three times.</string>
    <string name="plume_setup_welcome_privacy">Offline, no account, no ads: nothing leaves your phone.</string>
    <string name="plume_setup_language_title">Your main language</string>
    <string name="plume_setup_language_body">It sets the typography and the toggle key. The other language stays available.</string>
    <string name="plume_setup_language_fr_subtitle">Curly apostrophe, non-breaking spaces, « » quotes</string>
    <string name="plume_setup_language_en_subtitle">English spelling and punctuation</string>
    <string name="plume_setup_language_variant_fr">French of</string>
    <string name="plume_setup_language_variant_en">English</string>
    <string name="plume_setup_layout_title">Your layouts</string>
    <string name="plume_setup_layout_body">Suggested from the phone\'s region. Accents stay available with a long press on every layout.</string>
    <string name="plume_setup_layout_for_fr">For French</string>
    <string name="plume_setup_layout_for_en">For English</string>
    <string name="plume_setup_activate_title">Enable the keyboard</string>
    <string name="plume_setup_activate_body">Two Android settings, one tap each. You will come back here automatically.</string>
    <string name="plume_setup_activate_enable">1. Allow Clavier Plume</string>
    <string name="plume_setup_activate_enabled_done">1. Clavier Plume allowed ✓</string>
    <string name="plume_setup_activate_enable_subtitle">In Android\'s keyboard list, turn on “Clavier Plume”</string>
    <string name="plume_setup_activate_select">2. Choose it as your keyboard</string>
    <string name="plume_setup_activate_selected_done">2. Keyboard in use ✓</string>
    <string name="plume_setup_activate_select_subtitle">Pick “Clavier Plume” in the picker</string>
    <string name="plume_setup_activate_wait">Next unlocks once both steps are done.</string>
    <string name="plume_setup_theme_title">Your theme</string>
    <string name="plume_setup_theme_body">“Plume (auto)” follows the phone\'s light or dark mode. The Encre themes are high contrast.</string>
    <string name="plume_setup_vibrate">Vibrate on key press</string>
    <string name="plume_setup_vibrate_subtitle">A light touch under the finger</string>
    <string name="plume_setup_basics_title">The basics</string>
    <string name="plume_setup_basics_lang_title">Switch language</string>
    <string name="plume_setup_basics_lang_body">The EN / FR key switches instantly. Swiping the space bar does the same.</string>
    <string name="plume_setup_basics_space_title">Move the cursor</string>
    <string name="plume_setup_basics_space_body">Long-press the space bar, then slide: the keyboard becomes a trackpad.</string>
    <string name="plume_setup_basics_bar_title">Read the suggestion bar</string>
    <string name="plume_setup_basics_bar_body">The middle word is applied on space. The word in quotes is exactly what you typed: tap it to keep it.</string>
    <string name="plume_setup_basics_learn_title">Learn and forget</string>
    <string name="plume_setup_basics_learn_body">A new word is kept after its second use. The ↶ chip undoes a correction. Long-press a suggestion to forget it.</string>
    <string name="plume_setup_basics_voice_title">Dictate</string>
    <string name="plume_setup_basics_voice_body">The microphone dictates offline, in French and English. The phone asks for microphone access on first use.</string>
    <string name="plume_setup_contacts_title">Your contacts, optional</string>
    <string name="plume_setup_contacts_body">If allowed, the names in your address book are recognised and never corrected. They are read on the phone; nothing is sent.</string>
    <string name="plume_setup_contacts_allow">Allow contacts</string>
    <string name="plume_setup_contacts_done">Contacts recognised ✓</string>
    <string name="plume_setup_try_title">Try it</string>
    <string name="plume_setup_try_body_fr">Type the French words without accents or apostrophes, a space after each: “jaime lordinateur voila”. Watch the suggestion bar and the result.</string>
    <string name="plume_setup_try_body_en">Type a few words and watch the suggestion bar; tap the EN / FR key to switch language.</string>
    <string name="plume_setup_try_placeholder">Try typing here…</string>
    <string name="plume_setup_try_after">Everything else lives in the settings, seven screens. This walkthrough stays available under About.</string>
    <string name="plume_about_restart_setup">Redo the walkthrough</string>
    <string name="plume_about_restart_setup_subtitle">Languages, layouts, theme, the basics</string>
    <string name="plume_probabilistic_keys">Probabilistic keys (measurement)</string>
    <string name="plume_probabilistic_keys_subtitle">Widens keys by the expected next letter. Turn off for a week to compare in the typo log.</string>
    <string name="plume_setup_chosen">Chosen ✓</string>
