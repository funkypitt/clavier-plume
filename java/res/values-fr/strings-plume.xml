    <string name="plume_setup_welcome_title">Clavier Plume</string>
    <string name="plume_setup_welcome_body">Un clavier français et anglais, pensé d\'abord pour bien écrire le français. Une minute suffit pour le régler.</string>
    <string name="plume_setup_welcome_differs_title">Ce qui le distingue</string>
    <string name="plume_setup_welcome_differs">Les claviers du commerce sont conçus pour l\'anglais, et la plupart des claviers libres reprennent leur moteur tel quel. Plume, lui, connaît l\'élision (l\', d\', qu\'), retrouve les accents, respecte la typographie française, bascule entre deux langues d\'une touche, et n\'apprend un mot qu\'après l\'avoir vu trois fois.</string>
    <string name="plume_setup_welcome_privacy">Hors ligne, sans compte, sans publicité : rien ne quitte votre téléphone.</string>
    <string name="plume_setup_language_title">Votre langue principale</string>
    <string name="plume_setup_language_body">Elle règle la typographie et la touche de bascule. L\'autre langue reste toujours disponible.</string>
    <string name="plume_setup_language_fr_subtitle">Apostrophe courbe, espaces insécables, guillemets « »</string>
    <string name="plume_setup_language_en_subtitle">English spelling and punctuation</string>
    <string name="plume_setup_language_variant_fr">Français de</string>
    <string name="plume_setup_language_variant_en">Anglais</string>
    <string name="plume_setup_layout_title">Vos dispositions</string>
    <string name="plume_setup_layout_body">Proposées d\'après la région du téléphone. Les accents restent accessibles par appui long sur toutes les dispositions.</string>
    <string name="plume_setup_layout_for_fr">Pour le français</string>
    <string name="plume_setup_layout_for_en">Pour l\'anglais</string>
    <string name="plume_setup_activate_title">Activer le clavier</string>
    <string name="plume_setup_activate_body">Deux réglages d\'Android, un tap chacun. Vous reviendrez ici automatiquement.</string>
    <string name="plume_setup_activate_enable">1. Autoriser Clavier Plume</string>
    <string name="plume_setup_activate_enabled_done">1. Clavier Plume autorisé ✓</string>
    <string name="plume_setup_activate_enable_subtitle">Dans la liste des claviers d\'Android, activez « Clavier Plume »</string>
    <string name="plume_setup_activate_select">2. Le choisir comme clavier</string>
    <string name="plume_setup_activate_selected_done">2. Clavier en service ✓</string>
    <string name="plume_setup_activate_select_subtitle">Choisissez « Clavier Plume » dans le sélecteur</string>
    <string name="plume_setup_activate_wait">Le bouton Suivant s\'activera quand les deux étapes seront faites.</string>
    <string name="plume_setup_theme_title">Votre thème</string>
    <string name="plume_setup_theme_body">« Plume (auto) » suit le mode clair ou sombre du téléphone. Les thèmes Encre sont à fort contraste.</string>
    <string name="plume_setup_vibrate">Vibration à la frappe</string>
    <string name="plume_setup_vibrate_subtitle">Un léger retour sous le doigt</string>
    <string name="plume_setup_basics_title">Les bases</string>
    <string name="plume_setup_basics_lang_title">Changer de langue</string>
    <string name="plume_setup_basics_lang_body">La touche EN / FR bascule instantanément. Un glissement sur la barre d\'espace fait de même.</string>
    <string name="plume_setup_basics_space_title">Déplacer le curseur</string>
    <string name="plume_setup_basics_space_body">Appui long sur la barre d\'espace, puis glissez : le clavier devient un pavé tactile.</string>
    <string name="plume_setup_basics_bar_title">Lire la barre de suggestions</string>
    <string name="plume_setup_basics_bar_body">Le mot du milieu sera appliqué à l\'espace. Le mot entre guillemets est exactement ce que vous avez tapé : touchez-le pour le garder.</string>
    <string name="plume_setup_basics_learn_title">Apprendre et oublier</string>
    <string name="plume_setup_basics_learn_body">Un mot nouveau est retenu à sa deuxième validation. Le chip ↶ annule une correction. Appui long sur un mot suggéré pour l\'oublier.</string>
    <string name="plume_setup_basics_voice_title">Dicter</string>
    <string name="plume_setup_basics_voice_body">Le micro dicte hors ligne, en français comme en anglais. Le téléphone demandera l\'accès au micro à la première utilisation.</string>
    <string name="plume_setup_contacts_title">Vos contacts, en option</string>
    <string name="plume_setup_contacts_body">Si vous l\'autorisez, les prénoms et noms de votre carnet sont reconnus et jamais corrigés. Ils sont lus sur le téléphone, rien n\'est envoyé.</string>
    <string name="plume_setup_contacts_allow">Autoriser les contacts</string>
    <string name="plume_setup_contacts_done">Contacts reconnus ✓</string>
    <string name="plume_setup_try_title">Essayez</string>
    <string name="plume_setup_try_body_fr">Tapez sans accent ni apostrophe, puis un espace après chaque mot : « jaime lordinateur voila ». Regardez la barre de suggestions et le résultat.</string>
    <string name="plume_setup_try_body_en">Tapez quelques mots en anglais et regardez la barre de suggestions ; la touche FR bascule vers le français.</string>
    <string name="plume_setup_try_placeholder">Essayez de taper ici…</string>
    <string name="plume_setup_try_after">Tout se règle ensuite dans les réglages, en sept écrans. Cette prise en main reste disponible dans À propos.</string>
    <string name="plume_about_restart_setup">Revoir la prise en main</string>
    <string name="plume_about_restart_setup_subtitle">Langues, dispositions, thème, les bases</string>
    <string name="plume_probabilistic_keys">Touches probabilistes (mesure)</string>
    <string name="plume_probabilistic_keys_subtitle">Élargit les touches selon la lettre attendue. Coupez une semaine pour comparer dans le journal des typos.</string>
    <string name="plume_setup_chosen">Choisi ✓</string>
